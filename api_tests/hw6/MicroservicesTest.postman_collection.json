						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"token"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Update Profile User 1",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Profile updated', () => pm.response.to.have.status(200));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token1}}",
							"type": "string"
						}
					]
				},
				"method": "PUT",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"UpdatedName\",\n    \"lastname\": \"UpdatedLast\"\n}",
