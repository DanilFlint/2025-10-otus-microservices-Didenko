	"item": [
		{
			"name": "1. Register User 1",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Генерация случайных данных для Пользователя 1",
							"const randomId = pm.variables.replaceIn('{{$randomInt}}');",
							"pm.collectionVariables.set('user1_login', 'user' + randomId);",
							"pm.collectionVariables.set('user1_pass', 'pass' + randomId);",
							"pm.collectionVariables.set('user1_name', pm.variables.replaceIn('{{$randomFirstName}}'));",
							"pm.collectionVariables.set('user1_last', pm.variables.replaceIn('{{$randomLastName}}'));"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();",
							"pm.collectionVariables.set('user1_id', jsonData.id);",
							"pm.test('User 1 Registered', () => pm.response.to.have.status(201));"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"{{user1_name}}\",\n    \"lastname\": \"{{user1_last}}\",\n    \"login\": \"{{user1_login}}\",\n    \"password\": \"{{user1_pass}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"register"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Check Profile Unauthorized",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Unauthorized access denied', () => {",
							"    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/users/{{user1_id}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"users",
						"{{user1_id}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Login User 1",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const token1 = pm.response.text();",
							"pm.collectionVariables.set('token1', token1);",
							"pm.test('User 1 Logged in', () => pm.response.to.have.status(200));"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"login\": \"{{user1_login}}\",\n    \"password\": \"{{user1_pass}}\"\n}",
