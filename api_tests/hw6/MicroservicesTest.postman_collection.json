						"exec": [
							"const jsonData = pm.response.json();",
							"pm.test('Data is updated', () => {",
							"    pm.expect(jsonData.name).to.eql('UpdatedName');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
